DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=25000
DEEPSEEK_MAX_TOKENS=700
EXISTING_API_BASE_URL=
EXISTING_API_KEY=
EXISTING_API_APPROVED_ENDPOINTS=
EXISTING_API_CHAT_CONTEXT_ENDPOINT=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cloudflare Turnstile production credentials (required; test keys are rejected)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact comma-separated production hostnames configured on the Turnstile widget
TURNSTILE_ALLOWED_HOSTNAMES=trijotech.com,www.trijotech.com

# Nodemailer SMTP (required to send contact and careers emails)
SMTP_HOST=
# Use 587 with SMTP_SECURE=false, or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Use a sender address verified by your SMTP provider
SMTP_FROM="Trijotech <no-reply@example.com>"
CONTACT_TO_EMAIL=sales@trijotech.com
CAREERS_TO_EMAIL=hr@trijotech.com

# PostgreSQL / pgAdmin
# Keep real credentials in .env.local only. URL-encode special characters when using DATABASE_URL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=trijotech-nextjs
PGUSER=postgres
PGPASSWORD=Deepbro@33
PGSSL=false
DATABASE_URL=postgresql://postgres:replace-with-Deepbro@33localhost:5432/trijotech-nextjs