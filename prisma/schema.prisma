// ----------------------------------------------------
// GLOBAL NAVIGATION & HEADER/FOOTER MODELS
// ----------------------------------------------------

model HeaderNavItem {
  id          String               @id @default(uuid())
  name        String               @unique
  type        String               @default("link") // "link" | "dropdown"
  href        String
  description String               @db.Text
  sortOrder   Int                  @default(0)
  items       HeaderDropdownItem[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("header_navigation_items")
}

model HeaderDropdownItem {
  id          String        @id @default(uuid())
  navItemId   String
  name        String
  href        String
  description String        @db.Text
  hasImage    Boolean       @default(false)
  imageUrl    String        @default("")
  sortOrder   Int           @default(0)
  navItem     HeaderNavItem @relation(fields: [navItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([navItemId])
  @@map("header_dropdown_items")
}

model SiteConfigSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_config_settings")
}

