datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum FormStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum BlogStatus {
  draft
  published
}

// ----------------------------------------------------
// AUTH & ADMIN
// ----------------------------------------------------

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  name                String     @default("Administrator")
  role                Role       @default(ADMIN)
  isActive            Boolean    @default(true)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------
// CORE PAGES & CONTENT
// ----------------------------------------------------

model Page {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  metaTitle       String?
  metaDescription String?
  status          String        @default("published")
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]

  @@index([slug])
  @@map("pages")
}

model PageSection {
  id          String   @id @default(uuid())
  pageId      String
  sectionKey  String
  sectionType String   @default("general")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  content     Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey])
  @@index([pageId, sortOrder])
  @@map("page_sections")
}

model SiteContentEntry {
  id           String   @id
  scope        String   @default("page")
  pathname     String   @default("/")
  pageLabel    String   @default("")
  sectionKey   String   @default("general")
  sectionLabel String   @default("General")
  selector     String
  kind         String   @default("html")
  value        String   @db.Text
  attribute    String?
  label        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pathname])
  @@index([scope])
  @@index([sectionKey])
  @@map("site_content_entries")
}

model SiteSetting {
  id          String   @id
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("site_settings")
}

// ----------------------------------------------------
// BLOGS & MEDIA
// ----------------------------------------------------

model BlogPost {
  id                 String     @id @default(uuid())
  title              String
  slug               String     @unique
  shortDescription   String     @db.Text
  content            String     @db.Text
  contentBlocks      Json?
  contentImages      Json?
  featuredImage      String
  featuredImageStyle Json?
  imageAlt           String     @default("")
  author             String     @default("Trijotech")
  category           String     @default("General")
  tags               String[]   @default([])
  status             BlogStatus @default(draft)
  publishedAt        DateTime?
  seoTitle           String?
  seoDescription     String?    @db.Text
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model MediaAsset {
  id           String    @id @default(uuid())
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  width        Int?
  height       Int?
  altText      String?
  caption      String?
  storageType  String    @default("LOCAL_FILE")
  storageKey   String
  publicUrl    String
  data         Bytes?
  checksum     String?
  createdBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([publicUrl])
  @@index([storageKey])
  @@map("media_assets")
}

// ----------------------------------------------------
// FORM SUBMISSIONS
// ----------------------------------------------------

model ContactSubmission {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String
  company     String?
  inquiryType String?
  subject     String
  message     String     @db.Text
  status      FormStatus @default(NEW)
  ipAddress   String?
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

model CareerSubmission {
  id         String     @id @default(uuid())
  name       String
  email      String
  phone      String
  position   String
  experience String
  company    String?
  message    String     @db.Text
  resumeName String
  resumeMime String
  resumeSize Int
  resumeData Bytes?
  resumeUrl  String?
  status     FormStatus @default(NEW)
  ipAddress  String?
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("career_submissions")
}

// ----------------------------------------------------
// CHATBOT
// ----------------------------------------------------

model ChatbotKnowledgeEntry {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("general")
  content   String   @db.Text
  keywords  String[] @default([])
  priority  Int      @default(5)
  enabled   Boolean  @default(true)
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([enabled])
  @@map("chatbot_knowledge_entries")
}

model ChatbotSetting {
  id                   String   @id @default("default")
  enabled              Boolean  @default(true)
  assistantName        String   @default("Trijotech AI Assistant")
  welcomeMessage       String   @db.Text
  fallbackMessage      String   @db.Text
  suggestedQuestions   String[] @default([])
  contactButton        Boolean  @default(true)
  maximumMessageLength Int      @default(2000)
  updatedAt            DateTime @updatedAt

  @@map("chatbot_settings")
}

