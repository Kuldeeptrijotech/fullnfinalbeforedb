datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum FormStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum BlogStatus {
  draft
  published
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  name                String     @default("Administrator")
  role                Role       @default(ADMIN)
  isActive            Boolean    @default(true)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Page {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  metaTitle       String?
  metaDescription String?
  status          String        @default("published")
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]

  @@index([slug])
  @@map("pages")
}

model PageSection {
  id          String   @id @default(uuid())
  pageId      String
  sectionKey  String
  sectionType String   @default("general")
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  content     Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey])
  @@index([pageId, sortOrder])
  @@map("page_sections")
}

model SiteContentEntry {
  id           String   @id
  scope        String   @default("page")
  pathname     String   @default("/")
  pageLabel    String   @default("")
  sectionKey   String   @default("general")
  sectionLabel String   @default("General")
  selector     String
  kind         String   @default("html")
  value        String   @db.Text
  attribute    String?
  label        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pathname])
  @@index([scope])
  @@index([sectionKey])
  @@map("site_content_entries")
}

model SiteSetting {
  id          String   @id
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("site_settings")
}

model BlogPost {
  id                 String     @id @default(uuid())
  title              String
  slug               String     @unique
  shortDescription   String     @db.Text
  content            String     @db.Text
  contentBlocks      Json?
  contentImages      Json?
  featuredImage      String
  featuredImageStyle Json?
  imageAlt           String     @default("")
  author             String     @default("Trijotech")
  category           String     @default("General")
  tags               String[]   @default([])
  status             BlogStatus @default(draft)
  publishedAt        DateTime?
  seoTitle           String?
  seoDescription     String?    @db.Text
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model MediaAsset {
  id           String    @id @default(uuid())
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  width        Int?
  height       Int?
  altText      String?
  caption      String?
  storageType  String    @default("LOCAL_FILE")
  storageKey   String
  publicUrl    String
  data         Bytes?
  checksum     String?
  createdBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([publicUrl])
  @@index([storageKey])
  @@map("media_assets")
}

model ContactSubmission {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String
  company     String?
  inquiryType String?
  subject     String
  message     String     @db.Text
  status      FormStatus @default(NEW)
  ipAddress   String?
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

model CareerSubmission {
  id         String     @id @default(uuid())
  name       String
  email      String
  phone      String
  position   String
  experience String
  company    String?
  message    String     @db.Text
  resumeName String
  resumeMime String
  resumeSize Int
  resumeData Bytes?
  resumeUrl  String?
  status     FormStatus @default(NEW)
  ipAddress  String?
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("career_submissions")
}

model ChatbotKnowledgeEntry {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("general")
  content   String   @db.Text
  keywords  String[] @default([])
  priority  Int      @default(5)
  enabled   Boolean  @default(true)
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([enabled])
  @@map("chatbot_knowledge_entries")
}

model ChatbotSetting {
  id                   String   @id @default("default")
  enabled              Boolean  @default(true)
  assistantName        String   @default("Trijotech AI Assistant")
  welcomeMessage       String   @db.Text
  fallbackMessage      String   @db.Text
  suggestedQuestions   String[] @default([])
  contactButton        Boolean  @default(true)
  maximumMessageLength Int      @default(2000)
  updatedAt            DateTime @updatedAt

  @@map("chatbot_settings")
}

// ----------------------------------------------------
// DEDICATED RELATIONAL MODELS FOR HOMEPAGE & SECTIONS
// ----------------------------------------------------

model HeroSlide {
  id                String   @id @default(uuid())
  slug              String   @unique
  eyebrow           String
  title             String
  description       String   @db.Text
  primaryCtaLabel   String
  primaryCtaHref    String
  secondaryCtaLabel String
  secondaryCtaHref  String
  visualType        String   @default("video")
  visualSrc         String
  visualAlt         String
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("hero_slides")
}

model Service {
  id          String   @id @default(uuid())
  title       String   @unique
  description String   @db.Text
  href        String
  image       String   @default("")
  imageAlt    String   @default("")
  icon        String   @default("Compass")
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Product {
  id          String   @id @default(uuid())
  title       String   @unique
  description String   @db.Text
  href        String
  image       String
  imageAlt    String
  icon        String   @default("ReceiptText")
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model WhyChooseUsItem {
  id          String   @id @default(uuid())
  title       String   @unique
  description String   @db.Text
  image       String
  imageAlt    String
  icon        String   @default("Award")
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("why_choose_us_items")
}

model WhyChooseStat {
  id        String   @id @default(uuid())
  value     String
  label     String
  summary   String?  @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("why_choose_stats")
}

model SAPCapability {
  id        String   @id @default(uuid())
  text      String
  icon      String   @default("Layers")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sap_capabilities")
}

model SAPEcosystemNode {
  id        String   @id @default(uuid())
  label     String
  desc      String
  icon      String   @default("Database")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sap_ecosystem_nodes")
}

model Industry {
  id          String   @id @default(uuid())
  title       String   @unique
  description String   @db.Text
  href        String
  image       String
  imageAlt    String
  icon        String   @default("ShoppingCart")
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("industries")
}

model Testimonial {
  id          String   @id @default(uuid())
  companyName String
  writerName  String
  designation String
  testimonial String   @db.Text
  image       String   @default("")
  imageAlt    String   @default("")
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

model FeaturedVideo {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  youtubeId   String
  youtubeUrl  String
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("featured_videos")
}

model HomepageSectionConfig {
  id          String   @id
  sectionKey  String   @unique
  eyebrow     String   @default("")
  title       String   @default("")
  description String   @default("") @db.Text
  viewAllText String?
  viewAllHref String?
  ctaText     String?
  ctaHref     String?
  customData  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("homepage_section_configs")
}
